     ref_text: Optional[str] = None
 
 
+# pre-tokenizer regex that transformers 4.57.x installs for fix_mistral_regex=True
+_MISTRAL_FIX_REGEX = (
+    r"[^\r\n\p{L}\p{N}]?[\p{Lu}\p{Lt}\p{Lm}\p{Lo}\p{M}]*[\p{Ll}\p{Lm}\p{Lo}\p{M}]+|"
+    r"[^\r\n\p{L}\p{N}]?[\p{Lu}\p{Lt}\p{Lm}\p{Lo}\p{M}]+[\p{Ll}\p{Lm}\p{Lo}\p{M}]*|"
+    r"\p{N}| ?[^\s\p{L}\p{N}]+[\r\n/]*|\s*[\r\n]+|\s+(?!\S)|\s+"
+)
+
+
+def load_processor_compat(auto_processor_cls, path):
+    """AutoProcessor.from_pretrained(path, fix_mistral_regex=True) that also works on
+    transformers 5.0.x (which raises TypeError: multiple values for 'fix_mistral_regex').
+    On fallback the same pre-tokenizer regex transformers 4.57.x installs is applied."""
+    try:
+        return auto_processor_cls.from_pretrained(path, fix_mistral_regex=True)
+    except TypeError as e:
+        if "fix_mistral_regex" not in str(e):
+            raise
+    import tokenizers
+    from transformers.utils import logging as hf_logging
+
+    # the fallback load warns about the pre-tokenizer regex that is fixed below
+    verbosity = hf_logging.get_verbosity()
+    hf_logging.set_verbosity_error()
+    try:
+        proc = auto_processor_cls.from_pretrained(path)
+    finally:
+        hf_logging.set_verbosity(verbosity)
+    tok = getattr(proc, "tokenizer", proc)
+    backend = getattr(tok, "backend_tokenizer", None)
+    if backend is not None:
+        split = tokenizers.pre_tokenizers.Split(pattern=tokenizers.Regex(_MISTRAL_FIX_REGEX), behavior="isolated")
+        if isinstance(backend.pre_tokenizer, tokenizers.pre_tokenizers.Sequence):
+            backend.pre_tokenizer[0] = split
+        else:
+            backend.pre_tokenizer = tokenizers.pre_tokenizers.Sequence([split, backend.pre_tokenizer])
+    return proc
+
+
