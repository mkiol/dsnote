@@ -0,0 +1,50 @@
+cmake_minimum_required(VERSION 3.5)
+
+project(cld2_api LANGUAGES CXX VERSION 1.0.0)
+
+set(BUILD_SHARED_LIBS OFF)
+set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+
+add_compile_options(-Wno-non-c-typedef-for-linkage -Wno-narrowing)
+
+set(cld2_source_dir "${PROJECT_SOURCE_DIR}/internal")
