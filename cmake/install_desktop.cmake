function(check_patchelf)
    if(${patchelf_bin} MATCHES "-NOTFOUND$")
        message(FATAL_ERROR "patchelf not found but it is required to install files")
    endif()
endfunction()

function(strip_all file)
    install(CODE "execute_process(COMMAND ${CMAKE_STRIP} --strip-all ${file})")
endfunction()

function(remove_runpath file)
    check_patchelf()
    install(CODE "execute_process(COMMAND ${patchelf_bin} --remove-rpath ${file})")
endfunction()

function(set_runpath file)
    check_patchelf()
    install(CODE "execute_process(COMMAND ${patchelf_bin} --remove-rpath ${file})")
    install(CODE "execute_process(COMMAND ${patchelf_bin} --set-rpath ${rpath_install_dir} ${file})")
endfunction()

function(install_rhvoice_library lib_name)
    check_patchelf()
    install(CODE "
        file(GLOB versioned_libs \"${external_lib_dir}/${lib_name}.so.*.*.*\")
        list(LENGTH versioned_libs versioned_libs_count)
        if(NOT versioned_libs_count EQUAL 1)
            message(FATAL_ERROR \"Expected one ${lib_name} versioned shared library in ${external_lib_dir}, found \${versioned_libs_count}: \${versioned_libs}\")
        endif()
        list(GET versioned_libs 0 versioned_lib)
        execute_process(COMMAND ${CMAKE_STRIP} --strip-all \${versioned_lib})
        execute_process(COMMAND ${patchelf_bin} --remove-rpath \${versioned_lib})
        execute_process(COMMAND ${patchelf_bin} --set-rpath ${rpath_install_dir} \${versioned_lib})
        file(INSTALL DESTINATION \"\${CMAKE_INSTALL_PREFIX}/${lib_install_dir}\" TYPE PROGRAM FILES
            \${versioned_lib}
            \"${external_lib_dir}/${lib_name}.so.1\"
            \"${external_lib_dir}/${lib_name}.so\")
    ")
endfunction()

