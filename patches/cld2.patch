+    ${cld2_source_dir}/cld_generated_cjk_delta_bi_4.cc
+    ${cld2_source_dir}/generated_distinct_bi_0.cc
+    ${cld2_source_dir}/cld2_generated_quadchrome_2.cc
+    ${cld2_source_dir}/cld2_generated_deltaoctachrome.cc
+    ${cld2_source_dir}/cld2_generated_distinctoctachrome.cc
