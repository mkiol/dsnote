+
+const char* cld2_detect_language(const char* buffer, int buffer_length) {
+    CLD2::CLDHints cld_hints{};
+    CLD2::Language language3[3];
+    int percent3[3];
+    double normalized_score3[3];
+    bool is_reliable = false;
+    int text_bytes = 0;
+
+    auto lang = CLD2::ExtDetectLanguageSummary(
+        buffer, buffer_length, /*is_plain_text=*/true, &cld_hints, /*flags=*/0,
+        language3, percent3, normalized_score3, /*resultchunkvector=*/nullptr,
+        &text_bytes, &is_reliable);
+
+    return lang_str(lang);
+}
