+def _default_rope_parameters(config=None, device=None, seq_len=None, **kwargs):
+    # transformers>=5 removed ROPE_INIT_FUNCTIONS["default"]; same math as transformers 4.57.
+    # config.rope_theta must win: transformers>=5 injects a 10000.0 default into rope_parameters.
+    base = getattr(config, "rope_theta", None)
